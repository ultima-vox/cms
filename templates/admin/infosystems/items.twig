<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Элементы {{ infosystem.name }} — Ultima Vox CMS</title>
    <link rel="stylesheet" href="/assets/admin.css">
    <link rel="stylesheet" href="/assets/infosystems.css">
</head>
<body class="admin-shell">
    <aside class="admin-shell__sidebar">
        <div class="admin-brand">ULTIMA VOX</div>
        <nav class="admin-nav" aria-label="Основная навигация">
            <a class="admin-nav__item" href="/admin">Обзор</a>
            <a class="admin-nav__item" href="/admin/structure">Структура</a>
            <a class="admin-nav__item admin-nav__item--active" href="/admin/infosystems">Инфосистемы</a>
            <a class="admin-nav__item" href="/admin/layouts">Макеты</a>
        </nav>
    </aside>

    <main class="admin-shell__main">
        <header class="admin-page-header">
            <div>
                <p class="admin-eyebrow">{{ infosystem.code }}</p>
                <h1 class="admin-header__title">Элементы</h1>
                <p class="admin-page-header__description">{{ infosystem.name }} · найдено {{ pagination.total }}</p>
            </div>
            <div class="admin-actions">
                <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}">К инфосистеме</a>
                <a class="admin-button admin-button--primary" href="/admin/infosystems/{{ infosystem.id }}/items/create">Новый элемент</a>
            </div>
        </header>

        <section class="admin-panel">
            <form class="item-filters" method="get" action="/admin/infosystems/{{ infosystem.id }}/items">
                <label class="admin-field item-filters__search">
                    <span class="admin-field__label">Поиск</span>
                    <input class="admin-input" name="q" value="{{ filters.q }}" placeholder="Название, slug или путь">
                </label>
                <label class="admin-field">
                    <span class="admin-field__label">Группа</span>
                    <select class="admin-select" name="group_id">
                        <option value="">Все группы</option>
                        {% for group in groups %}
                            <option value="{{ group.id }}" {% if filters.group_id == group.id %}selected{% endif %}>{{ group.path }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    <span class="admin-field__label">Статус</span>
                    <select class="admin-select" name="status">
                        <option value="">Все</option>
                        {% for status in ['draft','published','archived'] %}
                            <option value="{{ status }}" {% if filters.status == status %}selected{% endif %}>{{ status }}</option>
                        {% endfor %}
                    </select>
                </label>
                <label class="admin-field">
                    <span class="admin-field__label">На странице</span>
                    <select class="admin-select" name="per_page">
                        {% for size in [25,50,100,200] %}
                            <option value="{{ size }}" {% if pagination.per_page == size %}selected{% endif %}>{{ size }}</option>
                        {% endfor %}
                    </select>
                </label>

                {% for field in filterable_fields %}
                    <label class="admin-field">
                        <span class="admin-field__label">{{ field.name }}</span>
                        {% if field.type == 'select' %}
                            <select class="admin-select" name="properties[{{ field.code }}]">
                                <option value="">Любое значение</option>
                                {% for option in field.options %}
                                    <option value="{{ option }}" {% if filters.properties[field.code]|default(null) == option %}selected{% endif %}>{{ option }}</option>
                                {% endfor %}
                            </select>
                        {% elseif field.type == 'boolean' %}
                            <select class="admin-select" name="properties[{{ field.code }}]">
                                <option value="">Любое</option>
                                <option value="1" {% if filters.properties[field.code]|default(null) is same as(true) %}selected{% endif %}>Да</option>
                                <option value="0" {% if filters.properties[field.code]|default(null) is same as(false) %}selected{% endif %}>Нет</option>
                            </select>
                        {% else %}
                            <input class="admin-input" name="properties[{{ field.code }}]" value="{{ filters.properties[field.code]|default('') }}" type="{{ field.type == 'number' ? 'number' : (field.type == 'date' ? 'date' : 'text') }}">
                        {% endif %}
                    </label>
                {% endfor %}

                <div class="admin-actions item-filters__actions">
                    <button class="admin-button admin-button--primary" type="submit">Применить</button>
                    <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}/items">Сбросить</a>
                </div>
            </form>
        </section>

        <section class="admin-panel admin-panel--flush content-section">
            {% if items is empty %}
                <div class="admin-empty">По заданным условиям элементы не найдены.</div>
            {% else %}
                <div class="content-table__head content-table__head--items"><span>Название</span><span>Группа</span><span>Статус</span><span>Путь</span><span></span></div>
                {% for item in items %}
                    <div class="content-row content-row--items">
                        <div><strong>{{ item.name }}</strong>{% if not item.is_active %} <span class="admin-badge">выкл.</span>{% endif %}</div>
                        <span class="content-row__muted">{{ item.group_name ?: 'Корень' }}</span>
                        <span class="admin-status admin-status--{{ item.status }}">{{ item.status }}</span>
                        <code>{{ item.path }}</code>
                        <a class="admin-link" href="/admin/infosystems/{{ infosystem.id }}/items/{{ item.id }}/edit">Изменить</a>
                    </div>
                {% endfor %}
            {% endif %}
        </section>

        {% if pagination.pages > 1 %}
            <nav class="admin-pagination" aria-label="Страницы">
                {% set separator = pagination.query ? '&' : '' %}
                {% if pagination.page > 1 %}
                    <a class="admin-button" href="?{{ pagination.query }}{{ separator }}page={{ pagination.page - 1 }}">← Назад</a>
                {% endif %}
                <span class="admin-pagination__summary">Страница {{ pagination.page }} из {{ pagination.pages }}</span>
                {% if pagination.page < pagination.pages %}
                    <a class="admin-button" href="?{{ pagination.query }}{{ separator }}page={{ pagination.page + 1 }}">Далее →</a>
                {% endif %}
            </nav>
        {% endif %}
    </main>
</body>
</html>
