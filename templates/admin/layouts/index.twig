{% extends 'admin/_shell.twig' %}
{% set admin_active = 'layouts' %}
{% set admin_title = 'Макеты' %}

{% block styles %}<link rel="stylesheet" href="/assets/layouts.css">{% endblock %}

{% block content %}
<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Presentation</p>
            <h1 class="admin-header__title">Макеты</h1>
            <p class="admin-page-header__description">Обычные HTML/PHP-макеты без XML/XSLT и отдельного шаблонного языка публичного сайта.</p>
        </div>
        <a class="admin-button admin-button--primary" href="/admin/layouts/create">Новый макет</a>
    </header>

    {% if deleted %}<div class="admin-notice admin-notice--success">Макет удалён.</div>{% endif %}

    <section class="admin-panel admin-panel--flush">
        {% if layouts is empty %}
            <div class="admin-empty">
                <h2 class="admin-panel__title">Макетов пока нет</h2>
                <p>Создайте первый HTML/PHP-макет для страниц сайта.</p>
            </div>
        {% else %}
            <div class="layout-list">
                <div class="layout-list__head">
                    <span>Макет</span><span>Файл</span><span>Узлы</span><span>Тип</span><span></span>
                </div>
                {% for layout in layouts %}
                    <div class="layout-row">
                        <div>
                            <strong>{{ layout.name }}</strong>
                            {% if layout.description %}<p class="layout-row__description">{{ layout.description }}</p>{% endif %}
                        </div>
                        <code>{{ layout.template_path }}</code>
                        <span>{{ layout.node_count }}</span>
                        <span>{% if layout.is_system %}<span class="admin-badge">системный</span>{% else %}пользовательский{% endif %}</span>
                        <a class="admin-link" href="/admin/layouts/{{ layout.id }}/edit">Изменить</a>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </section>
</div>
{% endblock %}
