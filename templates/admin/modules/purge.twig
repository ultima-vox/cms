{% extends 'admin/_shell.twig' %}
{% set admin_active = 'modules' %}
{% set admin_title = 'Удаление данных ' ~ module.code %}

{% block styles %}<link rel="stylesheet" href="/assets/modules.css">{% endblock %}

{% block content %}
<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Destructive operation</p>
            <h1 class="admin-header__title">Полностью удалить {{ module.name }}</h1>
            <p class="admin-page-header__description">Эта операция удалит код пакета и данные, объявленные модулем в purge-контракте. Откат после успешного commit не предусмотрен.</p>
        </div>
        <a class="admin-button admin-button--secondary" href="/admin/modules">Отмена</a>
    </header>

    <section class="admin-danger-zone module-purge-panel">
        <div class="module-purge-warning">
            <strong>{{ module.code }} {{ module.version }}</strong>
            <p>Будут выполнены destructive SQL scripts:</p>
            <ul>{% for script in module.purge_scripts %}<li><code>{{ script }}</code></li>{% endfor %}</ul>
        </div>
    </section>

    <section class="admin-panel" style="margin-top:20px">
        <form class="admin-form module-purge-form" method="post" action="/admin/modules/{{ module.code }}/purge" autocomplete="off">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">
            <label class="admin-field">
                <span class="admin-field__label">Для подтверждения введите точно: <code>{{ module.code }}</code></span>
                <input class="admin-input" type="text" name="confirmation" required spellcheck="false" autocomplete="off">
            </label>
            <div class="admin-actions"><button class="admin-button admin-button--danger" type="submit">Необратимо удалить модуль и его данные</button></div>
        </form>
    </section>
</div>
{% endblock %}
