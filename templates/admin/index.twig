<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Ultima Vox CMS</title>
    <link rel="stylesheet" href="/assets/admin.css">
</head>
<body class="admin-shell">
    <aside class="admin-shell__sidebar">
        <div class="admin-brand">ULTIMA VOX</div>
        <nav class="admin-nav" aria-label="Основная навигация">
            <a class="admin-nav__item admin-nav__item--active" href="/admin">Обзор</a>
            {% for item in navigation %}
                <a class="admin-nav__item" href="{{ item.path }}">{{ item.label }}</a>
            {% endfor %}
        </nav>
    </aside>

    <main class="admin-shell__main">
        <header class="admin-header">
            <div>
                <h1 class="admin-header__title">Панель управления</h1>
                <div class="admin-header__user">{{ user.display_name }} · {{ user.email }}</div>
            </div>

            <div class="admin-actions">
                {% if admin_sites|length > 1 %}
                    <form action="/admin/sites/select" method="post">
                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                        <label>
                            <span class="admin-header__user">Сайт</span>
                            <select name="site_id">
                                {% for site in admin_sites %}
                                    <option value="{{ site.id }}"{% if site.id == admin_site.id %} selected{% endif %}>
                                        {{ site.name }}{% if site.host %} · {{ site.host }}{% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>
                        <button class="admin-button admin-button--secondary" type="submit">Переключить</button>
                    </form>
                {% else %}
                    <span class="admin-header__user">Сайт: {{ admin_site.name }}</span>
                {% endif %}

                <form action="/admin/logout" method="post">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="admin-button admin-button--secondary" type="submit">Выйти</button>
                </form>
            </div>
        </header>

        <section class="admin-panel">
            <h2 class="admin-panel__title">{{ admin_site.name }}</h2>
            <p class="admin-panel__text">
                Текущий административный контекст: <code>{{ admin_site.code }}</code>{% if admin_site.host %} · {{ admin_site.host }}{% endif %}.
                Структура, инфосистемы и новые site-aware модули работают только с выбранным сайтом.
            </p>
            <div class="admin-actions">
                {% for item in navigation %}
                    <a class="admin-button admin-button--secondary" href="{{ item.path }}">{{ item.label }}</a>
                {% endfor %}
            </div>
        </section>
    </main>
</body>
</html>
