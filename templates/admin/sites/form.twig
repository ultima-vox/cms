{% extends 'admin/_shell.twig' %}
{% set admin_active = 'sites' %}
{% set admin_title = site.id ? 'Настройка сайта' : 'Новый сайт' %}

{% block content %}
<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Sites</p>
            <h1 class="admin-header__title">{{ site.id ? site.name : 'Новый сайт' }}</h1>
            {% if site.id %}<p class="admin-page-header__description">Код <code>{{ site.code }}</code> после создания не изменяется.</p>{% endif %}
        </div>
        <a class="admin-button admin-button--secondary" href="/admin/sites">К списку</a>
    </header>

    {% if error %}<div class="admin-notice admin-notice--error">{{ error }}</div>{% endif %}
    {% if saved %}<div class="admin-notice admin-notice--success">Изменения сохранены.</div>{% endif %}

    <form class="admin-form" action="{{ site.id ? '/admin/sites/' ~ site.id : '/admin/sites' }}" method="post">
        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
        <section class="admin-panel">
            <h2 class="admin-panel__title">Основное</h2>
            <div class="admin-form__grid">
                <label class="admin-field{% if site.id %} admin-field--wide{% endif %}">
                    <span class="admin-field__label">Название</span>
                    <input class="admin-input" name="name" value="{{ site.name }}" maxlength="255" required>
                </label>
                {% if site.id %}
                    <div class="admin-field">
                        <span class="admin-field__label">Код</span>
                        <code>{{ site.code }}</code>
                        <span class="admin-field__hint">Стабильный идентификатор сайта.</span>
                    </div>
                    <label class="admin-check">
                        <input type="checkbox" name="is_active" value="1"{% if site.is_active %} checked{% endif %}{% if site.code == 'default' %} disabled{% endif %}>
                        <span>Сайт активен</span>
                    </label>
                    {% if site.code == 'default' %}<input type="hidden" name="is_active" value="1">{% endif %}
                {% else %}
                    <label class="admin-field">
                        <span class="admin-field__label">Код</span>
                        <input class="admin-input" name="code" value="{{ site.code }}" maxlength="120" pattern="[a-z][a-z0-9_-]*" required>
                        <span class="admin-field__hint">a-z, 0-9, дефис и подчёркивание. После создания не меняется.</span>
                    </label>
                {% endif %}
            </div>
        </section>
        <div class="admin-actions"><button class="admin-button admin-button--primary" type="submit">Сохранить</button></div>
    </form>

    {% if site.id %}
        <section class="admin-panel" style="margin-top:20px">
            <div class="admin-panel__header">
                <div>
                    <h2 class="admin-panel__title">Домены</h2>
                    <p class="admin-panel__text">Домен хранится без схемы и порта. Один домен сайта может быть основным.</p>
                </div>
            </div>

            {% if domains is empty %}
                <div class="admin-empty">
                    <p>Домены ещё не добавлены. Для default-сайта продолжает работать host из APP_URL.</p>
                </div>
            {% else %}
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead><tr><th>Host</th><th>Тип</th><th></th></tr></thead>
                        <tbody>
                            {% for domain in domains %}
                                <tr>
                                    <td><code>{{ domain.host }}</code></td>
                                    <td>{% if domain.is_primary %}<span class="admin-badge admin-badge--success">основной</span>{% else %}<span class="admin-badge">alias</span>{% endif %}</td>
                                    <td>
                                        <div class="admin-actions">
                                            {% if not domain.is_primary %}
                                                <form action="/admin/sites/{{ site.id }}/domains/{{ domain.id }}/primary" method="post">
                                                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                    <button class="admin-button admin-button--secondary" type="submit">Сделать основным</button>
                                                </form>
                                            {% endif %}
                                            <form action="/admin/sites/{{ site.id }}/domains/{{ domain.id }}/delete" method="post">
                                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                <button class="admin-button admin-button--danger" type="submit">Удалить</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            <form class="admin-form" action="/admin/sites/{{ site.id }}/domains" method="post" style="margin-top:20px">
                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                <div class="admin-form__grid">
                    <label class="admin-field">
                        <span class="admin-field__label">Новый домен</span>
                        <input class="admin-input" name="host" placeholder="example.ru" maxlength="253" required>
                    </label>
                    <label class="admin-check"><input type="checkbox" name="is_primary" value="1"><span>Сделать основным</span></label>
                </div>
                <div class="admin-actions"><button class="admin-button admin-button--primary" type="submit">Добавить домен</button></div>
            </form>
        </section>
    {% endif %}
</div>
{% endblock %}
