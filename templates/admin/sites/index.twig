<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Сайты — Ultima Vox CMS</title>
    <link rel="stylesheet" href="/assets/admin.css">
</head>
<body class="admin-shell">
    <aside class="admin-shell__sidebar">
        <div class="admin-brand">ULTIMA VOX</div>
        <nav class="admin-nav" aria-label="Основная навигация">
            <a class="admin-nav__item" href="/admin">Обзор</a>
            <a class="admin-nav__item admin-nav__item--active" href="/admin/sites">Сайты</a>
            <a class="admin-nav__item" href="/admin/structure">Структура</a>
            <a class="admin-nav__item" href="/admin/infosystems">Инфосистемы</a>
            <a class="admin-nav__item" href="/admin/layouts">Макеты</a>
        </nav>
    </aside>

    <main class="admin-shell__main">
        <header class="admin-page-header">
            <div>
                <p class="admin-eyebrow">Sites</p>
                <h1 class="admin-header__title">Сайты</h1>
                <p class="admin-page-header__description">Текущий контекст: <strong>{{ admin_site.name }}</strong>. Домены определяют публичный SiteContext.</p>
            </div>
            <a class="admin-button admin-button--primary" href="/admin/sites/create">Новый сайт</a>
        </header>

        {% if saved %}<div class="admin-notice">Изменения сохранены.</div>{% endif %}

        <section class="admin-panel">
            {% if sites is empty %}
                <p>Сайты не найдены.</p>
            {% else %}
                <div class="admin-actions">
                    {% for site in sites %}
                        <article class="admin-panel">
                            <h2 class="admin-panel__title">{{ site.name }}</h2>
                            <p class="admin-panel__text">
                                <code>{{ site.code }}</code>
                                · {{ site.is_active ? 'активен' : 'выключен' }}
                                {% if site.primary_host %}· {{ site.primary_host }}{% endif %}
                            </p>
                            <p class="admin-panel__text">
                                Узлов: {{ site.node_count }} · инфосистем: {{ site.infosystem_count }} · доменов: {{ site.domain_count }}
                            </p>
                            <div class="admin-actions">
                                <a class="admin-button admin-button--secondary" href="/admin/sites/{{ site.id }}/edit">Настроить</a>
                                {% if site.is_active and site.id != admin_site.id %}
                                    <form action="/admin/sites/select" method="post">
                                        <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                        <input type="hidden" name="site_id" value="{{ site.id }}">
                                        <button class="admin-button admin-button--secondary" type="submit">Работать с сайтом</button>
                                    </form>
                                {% endif %}
                            </div>
                        </article>
                    {% endfor %}
                </div>
            {% endif %}
        </section>
    </main>
</body>
</html>
