{% extends 'admin/_shell.twig' %}
{% set admin_active = 'sites' %}
{% set admin_title = 'Сайты' %}

{% block content %}
<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Sites</p>
            <h1 class="admin-header__title">Сайты</h1>
            <p class="admin-page-header__description">Текущий контекст: <strong>{{ admin_site.name }}</strong>. Домены определяют публичный SiteContext.</p>
        </div>
        <a class="admin-button admin-button--primary" href="/admin/sites/create">Новый сайт</a>
    </header>

    {% if saved %}<div class="admin-notice admin-notice--success">Изменения сохранены.</div>{% endif %}

    {% if sites is empty %}
        <section class="admin-panel admin-empty">
            <h2 class="admin-panel__title">Сайты не найдены</h2>
            <p>Создайте первый сайт и назначьте ему публичный домен.</p>
        </section>
    {% else %}
        <section class="admin-panel admin-panel--flush">
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr><th>Сайт</th><th>Домен</th><th>Контент</th><th>Статус</th><th></th></tr>
                    </thead>
                    <tbody>
                        {% for site in sites %}
                            <tr>
                                <td>
                                    <span class="admin-table__primary">{{ site.name }}</span>
                                    <span class="admin-table__secondary"><code>{{ site.code }}</code></span>
                                </td>
                                <td>{{ site.primary_host ?: '—' }}</td>
                                <td>
                                    <span class="admin-table__primary">{{ site.node_count }} узл.</span>
                                    <span class="admin-table__secondary">{{ site.infosystem_count }} инфосистем · {{ site.domain_count }} доменов</span>
                                </td>
                                <td>
                                    {% if site.is_active %}<span class="admin-badge admin-badge--success">активен</span>{% else %}<span class="admin-badge">выключен</span>{% endif %}
                                    {% if site.id == admin_site.id %}<span class="admin-badge admin-badge--info">текущий</span>{% endif %}
                                </td>
                                <td>
                                    <div class="admin-actions">
                                        <a class="admin-button admin-button--secondary" href="/admin/sites/{{ site.id }}/edit">Настроить</a>
                                        {% if site.is_active and site.id != admin_site.id %}
                                            <form action="/admin/sites/select" method="post">
                                                <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                                                <input type="hidden" name="site_id" value="{{ site.id }}">
                                                <button class="admin-button admin-button--secondary" type="submit">Выбрать</button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
</div>
{% endblock %}
