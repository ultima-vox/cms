<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ node.title ?: node.name }}</title>
    {% if node.meta_description %}
        <meta name="description" content="{{ node.meta_description }}">
    {% endif %}
</head>
<body>
    <main>
        <h1>{{ node.title ?: node.name }}</h1>

        {% if node.content %}
            <div class="content">{{ node.content|raw }}</div>
        {% endif %}

        {% if items is not empty %}
            <section class="items">
                {% for item in items %}
                    <article class="item">
                        <h2>{{ item.name }}</h2>
                    </article>
                {% endfor %}
            </section>
        {% endif %}
    </main>
</body>
</html>
