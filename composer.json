{
    "name": "ultima-vox/cms",
    "description": "Lightweight CMS (PHP 8.4, PostgreSQL primary, MySQL/MariaDB legacy)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "nikic/fast-route": "^1.3",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "suggest": {
        "ext-pdo_pgsql": "Primary PostgreSQL database driver (default).",
        "ext-pdo_mysql": "Legacy MySQL/MariaDB database driver."
    }
}
