{
    "name": "ultima-vox/cms",
    "description": "Lightweight, high-performance CMS (PHP 8.4 + PostgreSQL)",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Core\\": "core/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
