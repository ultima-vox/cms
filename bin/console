#!/usr/bin/env php
<?php

declare(strict_types=1);

use Core\Database;
use Core\Extension\ModuleLoader;
use Core\Extension\ModuleManager;
use Core\Extension\ModuleMigrationRunner;
use Core\Extension\ModulePackageLifecycle;
use Core\Extension\ModulePackagePurger;
use Core\MigrationRunner;
use Core\View\PhpTemplateLinter;
use Core\View\TwigTemplateLinter;
use Dotenv\Dotenv;

$rootPath = dirname(__DIR__);
require $rootPath . '/vendor/autoload.php';
Dotenv::createImmutable($rootPath)->safeLoad();

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        $runner = new MigrationRunner(Database::connection(), $rootPath . '/database/migrations');
        $applied = $runner->migrate();

        if ($applied === []) {
            fwrite(STDOUT, "No pending migrations.\n");
            exit(0);
        }

        foreach ($applied as $migration) {
            fwrite(STDOUT, sprintf("Applied: %s\n", $migration));
        }
        exit(0);

    case 'modules:install':
        $archive = trim((string) ($argv[2] ?? ''));
        if ($archive === '') {
            fwrite(STDERR, "Usage: php bin/console modules:install <package.zip>\n");
            exit(1);
        }

        $manifest = (new ModulePackageLifecycle(Database::connection(), $rootPath))->install($archive);
        fwrite(
            STDOUT,
            sprintf(
                "Installed module package: %s %s (disabled; run extensions:sync, modules:migrate %s, then extensions:enable %s when ready).\n",
                $manifest->code,
                $manifest->version,
                $manifest->code,
                $manifest->code,
            ),
        );
        exit(0);

    case 'modules:update':
        $archive = trim((string) ($argv[2] ?? ''));
        if ($archive === '') {
            fwrite(STDERR, "Usage: php bin/console modules:update <package.zip>\n");
            exit(1);
        }

        $manifest = (new ModulePackageLifecycle(Database::connection(), $rootPath))->update($archive);
        fwrite(
            STDOUT,
            sprintf(
                "Updated module package: %s %s. Run extensions:sync, then modules:migrate %s before enabling it.\n",
                $manifest->code,
                $manifest->version,
                $manifest->code,
            ),
        );
        exit(0);

    case 'modules:remove':
        $code = trim((string) ($argv[2] ?? ''));
        if ($code === '') {
            fwrite(STDERR, "Usage: php bin/console modules:remove <module-code>\n");
            exit(1);
        }

        (new ModulePackageLifecycle(Database::connection(), $rootPath))->remove($code);
        fwrite(
            STDOUT,
            sprintf(
                "Removed module package code: %s. Module data and migration history were preserved.\n",
                $code,
            ),
        );
        exit(0);

    case 'modules:purge':
        $code = trim((string) ($argv[2] ?? ''));
        $confirm = '';
        foreach (array_slice($argv, 3) as $argument) {
            if (str_starts_with($argument, '--confirm=')) {
                $confirm = substr($argument, strlen('--confirm='));
            }
        }
        if ($code === '' || $confirm === '') {
            fwrite(STDERR, "Usage: php bin/console modules:purge <module-code> --confirm=<module-code>\n");
            exit(1);
        }

        (new ModulePackagePurger(Database::connection(), $rootPath))->purge($code, $confirm);
        fwrite(
            STDOUT,
            sprintf(
                "Purged module package: %s. Declared module data and migration history were destroyed.\n",
                $code,
            ),
        );
        exit(0);

    case 'modules:inventory':
        $rows = (new ModulePackageLifecycle(Database::connection(), $rootPath))->inventory();
        if ($rows === []) {
            fwrite(STDOUT, "No installer-managed module packages.\n");
            exit(0);
        }
        foreach ($rows as $row) {
            fwrite(
                STDOUT,
                sprintf(
                    "%s\t%s\t%s\t%s\n",
                    $row['module_code'],
                    $row['version'],
                    $row['package_sha256'],
                    $row['source'],
                ),
            );
        }
        exit(0);

    case 'modules:migrate':
        $code = trim((string) ($argv[2] ?? ''));
        if ($code === '') {
            fwrite(STDERR, "Usage: php bin/console modules:migrate <module-code>\n");
            exit(1);
        }

        $applied = (new ModuleMigrationRunner(Database::connection(), $rootPath))->migrate($code);
        if ($applied === []) {
            fwrite(STDOUT, sprintf("No pending migrations for module: %s\n", $code));
            exit(0);
        }

        foreach ($applied as $migration) {
            fwrite(STDOUT, sprintf("Applied %s: %s\n", $code, $migration));
        }
        exit(0);

    case 'extensions:sync':
        $result = (new ModuleManager(Database::connection(), $rootPath))->sync();
        fwrite(
            STDOUT,
            sprintf(
                "Extensions synced: %d discovered, %d enabled, %d permission definition(s).\n",
                $result['modules'],
                $result['loaded'],
                $result['permissions'],
            ),
        );
        exit(0);

    case 'extensions:list':
        $rows = (new ModuleManager(Database::connection(), $rootPath))->listing();
        if ($rows === []) {
            fwrite(STDOUT, "No modules discovered.\n");
            exit(0);
        }
        foreach ($rows as $row) {
            fwrite(
                STDOUT,
                sprintf(
                    "%s\t%s\t%s\t%s\t%s%s\n",
                    $row['code'],
                    $row['version'],
                    $row['enabled'] ? 'enabled' : 'disabled',
                    $row['extension_api'],
                    $row['name'],
                    $row['synchronized'] ? '' : ' [not synced]',
                ),
            );
        }
        exit(0);

    case 'extensions:enable':
    case 'extensions:disable':
        $code = trim((string) ($argv[2] ?? ''));
        if ($code === '') {
            fwrite(STDERR, sprintf("Usage: php bin/console %s <module-code>\n", $command));
            exit(1);
        }

        $manager = new ModuleManager(Database::connection(), $rootPath);
        if ($command === 'extensions:enable') {
            $manager->enable($code);
            fwrite(STDOUT, sprintf("Enabled module: %s\n", $code));
        } else {
            $manager->disable($code);
            fwrite(STDOUT, sprintf("Disabled module: %s\n", $code));
        }
        exit(0);

    case 'modules:list':
        $manifests = (new ModuleLoader($rootPath))->discover();
        if ($manifests === []) {
            fwrite(STDOUT, "No modules discovered.\n");
            exit(0);
        }
        foreach ($manifests as $manifest) {
            fwrite(STDOUT, sprintf("%s\t%s\t%s\n", $manifest->code, $manifest->version, $manifest->name));
        }
        exit(0);

    case 'health':
        Database::connection()->query('SELECT 1')->fetchColumn();
        fwrite(STDOUT, "OK\n");
        exit(0);

    case 'templates:lint':
        $phpChecked = array_merge(
            (new PhpTemplateLinter($rootPath . '/templates'))->lint(),
            (new PhpTemplateLinter($rootPath . '/modules'))->lint(),
        );
        $twigChecked = array_merge(
            (new TwigTemplateLinter($rootPath . '/templates'))->lint(),
            (new TwigTemplateLinter($rootPath . '/modules'))->lint(),
        );
        fwrite(
            STDOUT,
            sprintf(
                "Templates OK: %d PHP/HTML template(s), %d Twig admin/legacy template(s), including module-owned templates.\n",
                count($phpChecked),
                count($twigChecked),
            ),
        );
        exit(0);

    case 'user:create':
        $email = trim((string) ($argv[2] ?? ''));
        $displayName = trim((string) ($argv[3] ?? ''));
        $password = getenv('CMS_ADMIN_PASSWORD');

        if (filter_var($email, FILTER_VALIDATE_EMAIL) === false || $displayName === '') {
            fwrite(STDERR, "Usage: CMS_ADMIN_PASSWORD='strong-password' php bin/console user:create admin@example.com 'Administrator'\n");
            exit(1);
        }

        if (!is_string($password) || strlen($password) < 12) {
            fwrite(STDERR, "CMS_ADMIN_PASSWORD must contain at least 12 characters.\n");
            exit(1);
        }

        $db = Database::connection();
        $db->beginTransaction();

        try {
            $statement = $db->prepare(
                'INSERT INTO users (email, password_hash, display_name) VALUES (:email, :password_hash, :display_name) RETURNING id'
            );
            $statement->execute([
                'email' => $email,
                'password_hash' => password_hash($password, PASSWORD_DEFAULT),
                'display_name' => $displayName,
            ]);
            $userId = (int) $statement->fetchColumn();

            $roleStatement = $db->prepare(
                "INSERT INTO user_roles (user_id, role_id) SELECT :user_id, id FROM roles WHERE code = 'superadmin'"
            );
            $roleStatement->execute(['user_id' => $userId]);

            if ($roleStatement->rowCount() !== 1) {
                throw new RuntimeException('Role superadmin is missing. Run migrations first.');
            }

            $db->commit();
            fwrite(STDOUT, sprintf("Created superadmin: %s\n", $email));
            exit(0);
        } catch (Throwable $exception) {
            if ($db->inTransaction()) {
                $db->rollBack();
            }

            fwrite(STDERR, $exception->getMessage() . "\n");
            exit(1);
        }

    default:
        fwrite(
            STDOUT,
            "Ultima Vox CMS\n\nCommands:\n" .
            "  migrate                    Apply pending Core SQL migrations\n" .
            "  modules:install <zip>      Verify, install and inventory a disabled module package\n" .
            "  modules:update <zip>       Replace a disabled installer-managed module with a newer package\n" .
            "  modules:remove <code>      Remove disabled installer-managed package code; preserve its data\n" .
            "  modules:purge <code>       Destructively remove package and declared module data; requires --confirm=<code>\n" .
            "  modules:inventory          List installer-managed module packages\n" .
            "  modules:migrate <code>     Apply pending migrations owned by one module\n" .
            "  extensions:sync            Sync module metadata and enabled extension permissions\n" .
            "  extensions:list            List module lifecycle state\n" .
            "  extensions:enable <code>   Enable a synchronized module\n" .
            "  extensions:disable <code>  Disable a synchronized module\n" .
            "  modules:list               Validate and list discovered module manifests\n" .
            "  health                     Check database connectivity\n" .
            "  templates:lint             Parse core and module-owned PHP/Twig templates\n" .
            "  user:create                Create the initial super administrator\n"
        );
        exit($command === 'help' ? 0 : 1);
}
