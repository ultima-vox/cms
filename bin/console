#!/usr/bin/env php
<?php

declare(strict_types=1);

use Core\Database;
use Core\MigrationRunner;
use Dotenv\Dotenv;

$rootPath = dirname(__DIR__);
require $rootPath . '/vendor/autoload.php';
Dotenv::createImmutable($rootPath)->safeLoad();

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        $runner = new MigrationRunner(Database::connection(), $rootPath . '/database/migrations');
        $applied = $runner->migrate();

        if ($applied === []) {
            fwrite(STDOUT, "No pending migrations.\n");
            exit(0);
        }

        foreach ($applied as $migration) {
            fwrite(STDOUT, sprintf("Applied: %s\n", $migration));
        }
        exit(0);

    case 'health':
        Database::connection()->query('SELECT 1')->fetchColumn();
        fwrite(STDOUT, "OK\n");
        exit(0);

    default:
        fwrite(STDOUT, "Ultima Vox CMS\n\nCommands:\n  migrate  Apply pending SQL migrations\n  health   Check database connectivity\n");
        exit($command === 'help' ? 0 : 1);
}
