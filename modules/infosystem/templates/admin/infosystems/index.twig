{% extends 'admin/_shell.twig' %}
{% set admin_active = 'infosystems' %}
{% set admin_title = 'Инфосистемы' %}

{% block styles %}<link rel="stylesheet" href="/assets/infosystems.css">{% endblock %}

{% block content %}
<div class="admin-dashboard">
    <header class="admin-page-header">
        <div>
            <p class="admin-eyebrow">Content storage</p>
            <h1 class="admin-header__title">Инфосистемы</h1>
            <p class="admin-page-header__description">Каталоги, новости, услуги и другие структурированные наборы контента.</p>
        </div>
        <a class="admin-button admin-button--primary" href="/admin/infosystems/create">Новая инфосистема</a>
    </header>

    {% if deleted %}<div class="admin-notice admin-notice--success">Инфосистема удалена.</div>{% endif %}

    <section class="admin-panel admin-panel--flush">
        {% if infosystems is empty %}
            <div class="admin-empty">
                <h2 class="admin-panel__title">Инфосистем пока нет</h2>
                <p>Создайте структурированный набор контента для текущего сайта.</p>
            </div>
        {% else %}
            <div class="infosystem-list__head"><span>Название</span><span>Код</span><span>Группы</span><span>Элементы</span><span>Узлы</span><span></span></div>
            {% for system in infosystems %}
                <div class="infosystem-row">
                    <div>
                        <a class="admin-link infosystem-row__name" href="/admin/infosystems/{{ system.id }}">{{ system.name }}</a>
                        {% if system.description %}<p class="infosystem-row__description">{{ system.description }}</p>{% endif %}
                    </div>
                    <code>{{ system.code }}</code>
                    <span>{{ system.group_count }}</span>
                    <span>{{ system.item_count }}</span>
                    <span>{{ system.node_count }}</span>
                    <a class="admin-button admin-button--secondary" href="/admin/infosystems/{{ system.id }}/edit">Настройки</a>
                </div>
            {% endfor %}
        {% endif %}
    </section>
</div>
{% endblock %}
