<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ infosystem.name }} — Ultima Vox CMS</title>
    <link rel="stylesheet" href="/assets/admin.css">
    <link rel="stylesheet" href="/assets/infosystems.css">
</head>
<body class="admin-shell">
    <aside class="admin-shell__sidebar">
        <div class="admin-brand">ULTIMA VOX</div>
        <nav class="admin-nav" aria-label="Основная навигация">
            <a class="admin-nav__item" href="/admin">Обзор</a>
            <a class="admin-nav__item" href="/admin/structure">Структура</a>
            <a class="admin-nav__item admin-nav__item--active" href="/admin/infosystems">Инфосистемы</a>
            <a class="admin-nav__item" href="/admin/layouts">Макеты</a>
        </nav>
    </aside>

    <main class="admin-shell__main">
        <header class="admin-page-header">
            <div>
                <p class="admin-eyebrow">{{ infosystem.code }}</p>
                <h1 class="admin-header__title">{{ infosystem.name }}</h1>
                {% if infosystem.description %}<p class="admin-page-header__description">{{ infosystem.description }}</p>{% endif %}
            </div>
            <div class="admin-actions">
                <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}/edit">Настройки</a>
                <a class="admin-button" href="/admin/infosystems">К списку</a>
            </div>
        </header>

        {% if created %}<div class="admin-notice">Инфосистема создана.</div>{% endif %}
        {% if saved %}<div class="admin-notice">Изменения сохранены.</div>{% endif %}
        {% if deleted %}<div class="admin-notice">Объект удалён.</div>{% endif %}

        <div class="content-stats">
            <div class="content-stat"><strong>{{ infosystem.group_count }}</strong><span>групп</span></div>
            <div class="content-stat"><strong>{{ infosystem.item_count }}</strong><span>элементов</span></div>
            <div class="content-stat"><strong>{{ infosystem.field_schema|length }}</strong><span>доп. полей</span></div>
        </div>

        <section class="admin-panel admin-panel--flush content-section">
            <div class="content-section__header">
                <div>
                    <h2 class="admin-panel__title">Группы</h2>
                    <p class="admin-field__hint">Иерархия внутри инфосистемы. URL группы рассчитывается автоматически из slug и родителя.</p>
                </div>
                <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}/groups/create">Новая группа</a>
            </div>

            {% if groups is empty %}
                <div class="admin-empty">Групп нет. Элементы можно хранить и в корне инфосистемы.</div>
            {% else %}
                <div class="content-table__head content-table__head--groups"><span>Группа</span><span>Путь</span><span>Элементы</span><span></span></div>
                {% for group in groups %}
                    <div class="content-row content-row--groups">
                        <div class="content-row__tree" style="--tree-depth:{{ group.depth }}">
                            <strong>{{ group.name }}</strong>
                            {% if not group.is_active %}<span class="admin-badge">выкл.</span>{% endif %}
                        </div>
                        <code>{{ group.path }}</code>
                        <span>{{ group.item_count }}</span>
                        <a class="admin-link" href="/admin/infosystems/{{ infosystem.id }}/groups/{{ group.id }}/edit">Изменить</a>
                    </div>
                {% endfor %}
            {% endif %}
        </section>

        <section class="admin-panel admin-panel--flush content-section">
            <div class="content-section__header">
                <div>
                    <h2 class="admin-panel__title">Элементы</h2>
                    <p class="admin-field__hint">На обзоре показаны первые 25 из {{ item_total }} элементов. Поиск, фильтры и пагинация доступны в полном списке.</p>
                </div>
                <div class="admin-actions">
                    <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}/items">Все элементы</a>
                    <a class="admin-button admin-button--primary" href="/admin/infosystems/{{ infosystem.id }}/items/create">Новый элемент</a>
                </div>
            </div>

            {% if items is empty %}
                <div class="admin-empty">Элементов пока нет.</div>
            {% else %}
                <div class="content-table__head content-table__head--items"><span>Название</span><span>Группа</span><span>Статус</span><span>Путь</span><span></span></div>
                {% for item in items %}
                    <div class="content-row content-row--items">
                        <strong>{{ item.name }}</strong>
                        <span class="content-row__muted">{{ item.group_name ?: 'Корень' }}</span>
                        <span class="admin-status admin-status--{{ item.status }}">{{ item.status }}</span>
                        <code>{{ item.path }}</code>
                        <a class="admin-link" href="/admin/infosystems/{{ infosystem.id }}/items/{{ item.id }}/edit">Изменить</a>
                    </div>
                {% endfor %}
            {% endif %}
        </section>
    </main>
</body>
</html>
