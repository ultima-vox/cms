<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ item.id ? 'Редактирование элемента' : 'Новый элемент' }} — Ultima Vox CMS</title>
    <link rel="stylesheet" href="/assets/admin.css">
    <link rel="stylesheet" href="/assets/infosystems.css">
</head>
<body class="admin-shell">
    <aside class="admin-shell__sidebar">
        <div class="admin-brand">ULTIMA VOX</div>
        <nav class="admin-nav" aria-label="Основная навигация">
            <a class="admin-nav__item" href="/admin">Обзор</a>
            <a class="admin-nav__item" href="/admin/structure">Структура</a>
            <a class="admin-nav__item admin-nav__item--active" href="/admin/infosystems">Инфосистемы</a>
            <a class="admin-nav__item" href="/admin/layouts">Макеты</a>
        </nav>
    </aside>

    <main class="admin-shell__main">
        <header class="admin-page-header">
            <div>
                <p class="admin-eyebrow">{{ infosystem.code }}</p>
                <h1 class="admin-header__title">{{ item.id ? item.name : 'Новый элемент' }}</h1>
                {% if item.path %}<p class="admin-page-header__description"><code>{{ item.path }}</code></p>{% endif %}
            </div>
            <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}">К инфосистеме</a>
        </header>

        {% if saved %}<div class="admin-notice">Элемент сохранён.</div>{% endif %}
        {% if error %}<div class="admin-notice admin-notice--error">{{ error }}</div>{% endif %}

        <form class="admin-form" method="post" action="{{ item.id ? '/admin/infosystems/' ~ infosystem.id ~ '/items/' ~ item.id : '/admin/infosystems/' ~ infosystem.id ~ '/items' }}">
            <input type="hidden" name="_csrf" value="{{ csrf_token }}">

            <section class="admin-panel">
                <h2 class="admin-panel__title">Основное</h2>
                <div class="admin-form__grid">
                    <label class="admin-field admin-field--wide">
                        <span class="admin-field__label">Название</span>
                        <input class="admin-input" name="name" required maxlength="255" value="{{ item.name }}">
                    </label>
                    <label class="admin-field">
                        <span class="admin-field__label">Группа</span>
                        <select class="admin-select" name="group_id">
                            <option value="">Корень инфосистемы</option>
                            {% for group in groups %}
                                <option value="{{ group.id }}" {% if item.group_id == group.id %}selected{% endif %}>{{ group.path }} — {{ group.name }}</option>
                            {% endfor %}
                        </select>
                    </label>
                    <label class="admin-field">
                        <span class="admin-field__label">Slug</span>
                        <input class="admin-input" name="slug" required maxlength="255" pattern="[a-z0-9][a-z0-9-]*" value="{{ item.slug }}">
                    </label>
                    <label class="admin-field admin-field--wide">
                        <span class="admin-field__label">Краткое описание</span>
                        <textarea class="admin-textarea admin-textarea--small" name="description">{{ item.description }}</textarea>
                    </label>
                    <label class="admin-field admin-field--wide">
                        <span class="admin-field__label">Контент</span>
                        <textarea class="admin-textarea admin-textarea--content" name="content">{{ item.content }}</textarea>
                    </label>
                    <label class="admin-field admin-field--wide">
                        <span class="admin-field__label">Meta description</span>
                        <textarea class="admin-textarea admin-textarea--small" name="meta_description" maxlength="320">{{ item.meta_description }}</textarea>
                    </label>
                </div>
            </section>

            {% if fields is not empty %}
                <section class="admin-panel">
                    <h2 class="admin-panel__title">Дополнительные свойства</h2>
                    <div class="admin-form__grid">
                        {% for field in fields %}
                            {% set value = item.properties[field.code]|default(null) %}
                            {% if field.type == 'textarea' %}
                                <label class="admin-field admin-field--wide">
                                    <span class="admin-field__label">{{ field.name }}{% if field.required %} *{% endif %}</span>
                                    <textarea class="admin-textarea admin-textarea--small" name="properties[{{ field.code }}]" {% if field.required %}required{% endif %}>{{ value }}</textarea>
                                </label>
                            {% elseif field.type == 'boolean' %}
                                <label class="admin-check">
                                    <input type="hidden" name="properties[{{ field.code }}]" value="0">
                                    <input type="checkbox" name="properties[{{ field.code }}]" value="1" {% if value %}checked{% endif %}>
                                    <span>{{ field.name }}</span>
                                </label>
                            {% elseif field.type == 'select' %}
                                <label class="admin-field">
                                    <span class="admin-field__label">{{ field.name }}{% if field.required %} *{% endif %}</span>
                                    <select class="admin-select" name="properties[{{ field.code }}]" {% if field.required %}required{% endif %}>
                                        <option value="">—</option>
                                        {% for option in field.options %}<option value="{{ option }}" {% if value == option %}selected{% endif %}>{{ option }}</option>{% endfor %}
                                    </select>
                                </label>
                            {% else %}
                                <label class="admin-field">
                                    <span class="admin-field__label">{{ field.name }}{% if field.required %} *{% endif %}</span>
                                    <input class="admin-input" name="properties[{{ field.code }}]" value="{{ value }}" type="{{ field.type == 'number' ? 'number' : (field.type == 'date' ? 'date' : 'text') }}" {% if field.type == 'number' %}step="any"{% endif %} {% if field.required %}required{% endif %}>
                                </label>
                            {% endif %}
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            <section class="admin-panel">
                <h2 class="admin-panel__title">Публикация</h2>
                <div class="admin-form__grid">
                    <label class="admin-field">
                        <span class="admin-field__label">Статус</span>
                        <select class="admin-select" name="status">
                            {% for status in ['draft','published','archived'] %}<option value="{{ status }}" {% if item.status == status %}selected{% endif %}>{{ status }}</option>{% endfor %}
                        </select>
                    </label>
                    <label class="admin-field">
                        <span class="admin-field__label">Опубликовать не раньше</span>
                        <input class="admin-input" type="datetime-local" name="publish_at" value="{{ item.publish_at ? item.publish_at|date('Y-m-d\\TH:i') : '' }}">
                    </label>
                    <label class="admin-field">
                        <span class="admin-field__label">Сортировка</span>
                        <input class="admin-input" type="number" min="0" name="sorting" value="{{ item.sorting }}">
                    </label>
                    <label class="admin-check">
                        <input type="hidden" name="is_active" value="0">
                        <input type="checkbox" name="is_active" value="1" {% if item.is_active %}checked{% endif %}>
                        <span>Элемент активен</span>
                    </label>
                </div>
            </section>

            <div class="admin-actions">
                <button class="admin-button admin-button--primary" type="submit">Сохранить</button>
                <a class="admin-button" href="/admin/infosystems/{{ infosystem.id }}">Отмена</a>
            </div>
        </form>

        {% if item.id %}
            <section class="admin-danger-zone">
                <div><strong>Удаление элемента</strong><p>Действие необратимо.</p></div>
                <form method="post" action="/admin/infosystems/{{ infosystem.id }}/items/{{ item.id }}/delete" onsubmit="return confirm('Удалить элемент?');">
                    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
                    <button class="admin-button admin-button--danger" type="submit">Удалить</button>
                </form>
            </section>
        {% endif %}
    </main>
</body>
</html>
